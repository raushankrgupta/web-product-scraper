MONGO_URI=""
PORT="8080"

# --- Google sign-in ---
#
# GoogleLoginHandler checks the token's `aud` and `azp` against every client id
# set below, and FAILS CLOSED: in production, with none of the three set, every
# Google login is refused with a 500. Set the ones your clients actually mint
# tokens with — an Android app requesting an ID token against a server client
# carries that server id in `aud` and the Android id in `azp`, so both are
# checked and either one matching is enough.
GOOGLE_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URL=""
GEMINI_API_KEY=""

# --- Image generation providers -------------------------------------------
#
# OpenAI is a FALLBACK for Gemini, not something the user picks. The app sells
# "Standard" and "Pro"; which vendor renders them is operational.
#
# OPENAI_ENABLED off (the default) means the provider list is exactly
# ["gemini"] and no OpenAI code path can be reached. It is also forced off
# without a key, so a half-configured deployment cannot turn every fallback
# into a wasted round trip.
#
# IMAGE_PROVIDER_PREFERENCE picks which vendor is tried FIRST; the other
# becomes the fallback. Both tiers are priced so either vendor clears the
# margin floor (run `go run ./tools/stars_check`), so flipping this cannot
# make a generation unprofitable. Setting it to "openai" while OPENAI_ENABLED
# is false logs a warning and falls back to gemini.
#
# A fallback is only attempted when the first vendor failed to REACH the model
# (quota, circuit open, transport error, timeout). Content refusals are never
# retried on the other vendor: OpenAI's moderation is stricter than Gemini's on
# photos of real people, so that would buy two refusals and two bills. See
# docs/OPENAI_IMAGE_FALLBACK.md.
OPENAI_API_KEY=""
OPENAI_ENABLED="false"
IMAGE_PROVIDER_PREFERENCE="gemini"
# Ceiling for one OpenAI call. A fallback runs on whatever is left of the
# request, so this caps rather than grants a budget.
OPENAI_TIMEOUT_SECS="90"
RESEND_API_KEY=""
# Sender address. Domain must be verified in the Resend dashboard.
# For testing before verification use: EMAIL_FROM="onboarding@resend.dev"
# (that sender only delivers to your own Resend account email).
EMAIL_FROM="TryOnFusion App <no-reply@tryonfusion.com>"
# Signs every session token. ValidateToken refuses ALL tokens when this is
# empty, and startup logs a SECURITY WARNING when it is under 32 characters in
# production. Generate with: openssl rand -base64 48
# Rotating it logs every user out — and STARS_IDENTITY_PEPPER falls back to it,
# so set that explicitly first (see the note at the bottom of this file).
JWT_SECRET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_BUCKET_NAME=""
DB_NAME=""
CONTACT_EMAIL=""
SERVER_B_SCRAPE_URL=""
INTERNAL_API_SECRET=""
# Master switch for the scrape-offload path. Defaults to "on when
# SERVER_B_SCRAPE_URL is set". Set to false to keep the URL on file but scrape
# locally only — B is then never dialled, probed, or alerted on.
SERVER_B_ENABLED="true"

# --- Telegram failure notifier ---
# Alerts stay OFF unless both the token and the chat id are set.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
ALERTS_ENABLED="true"
# warn | error | fatal
ALERT_MIN_LEVEL="warn"
# Per-fingerprint suppression window, seconds.
ALERT_COOLDOWN_SECS="300"

# prod | staging | dev. Tags alerts and gates the dev-only routes. Both "prod"
# and "production" count as production; anything else does not.
ENVIRONMENT="prod"

# Second lock on /internal/alert-test and /internal/stars — the latter mints
# stars with no payment. Both conditions must hold for them to be mounted:
# a non-production ENVIRONMENT *and* this set to "true". Leave it false or
# unset in production; an ENVIRONMENT typo alone can no longer expose them.
ENABLE_DEV_ROUTES="false"

# --- Generation timeouts (seconds) ---
# NOTE: try-on generation now takes its budget from the per-quality
# timeout_secs / multi_timeout_secs in config/stars.json, so that a tier's
# price and its time budget cannot drift apart. These two remain as the
# fallback for a quality that does not specify one.
GEMINI_TIMEOUT_SECS="45"
GEMINI_MULTI_TIMEOUT_SECS="90"
# Deadline for storing a finished generation to S3. Runs on its own context,
# not the request's, so a caller who hangs up cannot discard a result we have
# already paid Gemini to produce.
S3_UPLOAD_TIMEOUT_SECS="30"

# --- CORS ---
# Comma-separated allow-list. Empty means "*" (previous behaviour).
ALLOWED_ORIGINS=""

# debug | info | warn | error
LOG_LEVEL="info"

# --- Star economy / Google Play billing ---
#
# Prices, model mapping and free-tier rules live in config/stars.json, which is
# compiled into the binary. Point this at an external file to reprice without a
# rebuild; leave empty to use the embedded config.
STARS_CONFIG_PATH=""

# Service account with the Android Publisher scope, used to verify purchase
# tokens with Google. Supply EITHER the whole JSON key inline (preferred — no
# file to mount into the container) OR a path to it. With neither set,
# /billing/purchase returns 503 and no purchase can be credited.
PLAY_SERVICE_ACCOUNT_JSON=""
PLAY_SERVICE_ACCOUNT_FILE=""

# Shared secret appended to the Pub/Sub push URL as ?token=... . Google will
# push to any public URL, so without this anyone who finds the endpoint can
# forge a refund notification and zero out a balance. Generate with:
#   openssl rand -hex 32
PLAY_RTDN_TOKEN=""

# Salts the SHA-256 of an email address before it is stored for returning-user
# detection (the rule that stops delete-and-rejoin farming the welcome bonus).
# Falls back to JWT_SECRET when unset. CHANGING IT RESETS EVERY USER TO "NEW" —
# treat it as permanent once live. Generate with: openssl rand -hex 32
STARS_IDENTITY_PEPPER=""
