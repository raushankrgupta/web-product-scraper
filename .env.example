MONGO_URI=""
PORT=8080"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URL=""
GEMINI_API_KEY=""
RESEND_API_KEY=""
# Sender address. Domain must be verified in the Resend dashboard.
# For testing before verification use: EMAIL_FROM="onboarding@resend.dev"
# (that sender only delivers to your own Resend account email).
EMAIL_FROM="TryOnFusion App <no-reply@tryonfusion.com>"
JWT_SECRET="/"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_BUCKET_NAME=""
DB_NAME=""
CONTACT_EMAIL=""
CHROME_HEADLESS=false"
SERVER_B_SCRAPE_URL=""
INTERNAL_API_SECRET=""
# Master switch for the scrape-offload path. Defaults to "on when
# SERVER_B_SCRAPE_URL is set". Set to false to keep the URL on file but scrape
# locally only — B is then never dialled, probed, or alerted on.
SERVER_B_ENABLED="true"

# --- Telegram failure notifier ---
# Alerts stay OFF unless both the token and the chat id are set.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
ALERTS_ENABLED="true"
# warn | error | fatal
ALERT_MIN_LEVEL="warn"
# Per-fingerprint suppression window, seconds.
ALERT_COOLDOWN_SECS="300"

# prod | staging | dev. Tags alerts and gates /internal/alert-test.
ENVIRONMENT="prod"

# --- Generation timeouts (seconds) ---
# NOTE: try-on generation now takes its budget from the per-quality
# timeout_secs / multi_timeout_secs in config/stars.json, so that a tier's
# price and its time budget cannot drift apart. These two remain as the
# fallback for a quality that does not specify one.
GEMINI_TIMEOUT_SECS="45"
GEMINI_MULTI_TIMEOUT_SECS="90"
# Deadline for storing a finished generation to S3. Runs on its own context,
# not the request's, so a caller who hangs up cannot discard a result we have
# already paid Gemini to produce.
S3_UPLOAD_TIMEOUT_SECS="30"

# --- CORS ---
# Comma-separated allow-list. Empty means "*" (previous behaviour).
ALLOWED_ORIGINS=""

# debug | info | warn | error
LOG_LEVEL="info"

# --- Star economy / Google Play billing ---
#
# Prices, model mapping and free-tier rules live in config/stars.json, which is
# compiled into the binary. Point this at an external file to reprice without a
# rebuild; leave empty to use the embedded config.
STARS_CONFIG_PATH=""

# Service account with the Android Publisher scope, used to verify purchase
# tokens with Google. Supply EITHER the whole JSON key inline (preferred — no
# file to mount into the container) OR a path to it. With neither set,
# /billing/purchase returns 503 and no purchase can be credited.
PLAY_SERVICE_ACCOUNT_JSON=""
PLAY_SERVICE_ACCOUNT_FILE=""

# Shared secret appended to the Pub/Sub push URL as ?token=... . Google will
# push to any public URL, so without this anyone who finds the endpoint can
# forge a refund notification and zero out a balance. Generate with:
#   openssl rand -hex 32
PLAY_RTDN_TOKEN=""

# Salts the SHA-256 of an email address before it is stored for returning-user
# detection (the rule that stops delete-and-rejoin farming the welcome bonus).
# Falls back to JWT_SECRET when unset. CHANGING IT RESETS EVERY USER TO "NEW" —
# treat it as permanent once live. Generate with: openssl rand -hex 32
STARS_IDENTITY_PEPPER=""
